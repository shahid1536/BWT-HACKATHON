# Optional Backend API URL for Frontend
# In local development with Vite proxy, leave empty or default to /api
# In production / deployed setup (e.g. Vercel, Netlify), set this to your deployed backend URL:
# VITE_API_URL=https://your-backend-api.onrender.com/api

# Optional custom backend target for Vite local dev proxy (default is http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
