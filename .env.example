# ==========================================
# DocuKeep - Environment Variables Example
# ==========================================

# Copy this file to server/.env for local backend development.
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
# Local development may use an in-memory database if MongoDB is unavailable.
# Production requires persistent MongoDB and never falls back to memory.
MONGODB_URI=mongodb://127.0.0.1:27017/docukeep

# Use a unique random value of at least 32 characters in production.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Frontend origin(s) allowed to call the backend. Multiple origins can be comma-separated.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://bwt-project.vercel.app,https://your-preview-domain.vercel.app

# Production uses the same-origin Vercel API and does not need VITE_API_URL.
# Connect a private Vercel Blob store to this project for persistent uploads.
# Set MONGODB_URI and a unique JWT_SECRET (32+ characters) in Vercel server
# environment variables. Never use these server-only values as VITE_ variables.
