# ==========================================
# DocuKeep - Environment Variables Example
# ==========================================

# --- Backend Server Configuration (server/.env) ---
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
# If local MongoDB is not running, the application will automatically fall back to an in-memory database for seamless local development
MONGODB_URI=mongodb://127.0.0.1:27017/docukeep

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client Origin (for CORS allowed origins)
CLIENT_URL=http://localhost:5173

# --- Frontend Client Configuration (client/.env) ---
# In development with Vite proxy, leave empty or '/api'
# In production or when deploying frontend separately, set to the backend API endpoint:
# VITE_API_URL=https://your-backend.onrender.com/api
